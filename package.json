{
  "name": "agentdock",
  "version": "0.1.0",
  "description": "Reusable TypeScript agent infrastructure for AgentDock applications",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-Zain01/agentdock.git"
  },
  "homepage": "https://github.com/Muhammad-Zain01/agentdock#readme",
  "bugs": {
    "url": "https://github.com/Muhammad-Zain01/agentdock/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./tools": {
      "types": "./dist/tools/registry.d.ts",
      "import": "./dist/tools/registry.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "yarn clean && tsc -p tsconfig.json",
    "build:all": "yarn build && yarn build:models",
    "build:models": "yarn --cwd packages/models build",
    "format": "prettier --write src test scripts packages package.json README.md",
    "format:check": "prettier --check src test scripts packages package.json README.md",
    "install:models": "yarn --cwd packages/models install",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "yarn typecheck && yarn typecheck:models",
    "typecheck:models": "yarn --cwd packages/models typecheck",
    "test:unit": "vitest run test/unit",
    "test": "yarn test:unit && yarn test:models",
    "test:models": "yarn --cwd packages/models test",
    "test:scenarios": "yarn build:all && node scripts/scenarios/streaming.mjs && node scripts/scenarios/tool-call.mjs && node scripts/scenarios/approval.mjs",
    "test:watch": "vitest",
    "pack:artifact": "yarn pack --filename agentdock.tgz",
    "prepack": "yarn build",
    "prepare": "yarn build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "langchain": "^1.5.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
