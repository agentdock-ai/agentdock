{
  "name": "agentdock-workspace",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn build:contracts && yarn typecheck:contracts && yarn typecheck:agentdock",
    "test": "yarn workspace @agentdock-ai/contracts test && yarn workspace @agentdock-ai/agentdock test",
    "test:coverage": "yarn workspace @agentdock-ai/agentdock test:coverage",
    "test:integration:services": "yarn build && yarn workspace @agentdock-ai/agentdock test:integration",
    "build": "yarn build:contracts && yarn build:agentdock",
    "ci": "yarn format:check && yarn typecheck && yarn build && yarn test && yarn test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && changeset publish",
    "typecheck:contracts": "yarn workspace @agentdock-ai/contracts typecheck",
    "typecheck:agentdock": "yarn workspace @agentdock-ai/agentdock typecheck",
    "build:contracts": "yarn workspace @agentdock-ai/contracts build",
    "build:agentdock": "yarn workspace @agentdock-ai/agentdock build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
