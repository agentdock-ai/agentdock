{
  "name": "@agentdock-ai/agentdock",
  "version": "0.1.0",
  "description": "Reusable TypeScript agent infrastructure for AgentDock applications",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentdock-ai/agentdock.git",
    "directory": "packages/agentdock"
  },
  "homepage": "https://github.com/agentdock-ai/agentdock#readme",
  "bugs": {
    "url": "https://github.com/agentdock-ai/agentdock/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./tools": {
      "types": "./dist/tools/registry.d.ts",
      "import": "./dist/tools/registry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "yarn clean && tsc -p tsconfig.json",
    "format": "prettier --write src test scripts package.json README.md",
    "format:check": "prettier --check src test scripts package.json README.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test/unit",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "test": "yarn test:types && yarn test:unit && yarn test:integration",
    "test:scenarios": "yarn build && yarn workspace @agentdock-ai/models build && node scripts/scenarios/streaming.mjs && node scripts/scenarios/tool-call.mjs && node scripts/scenarios/approval.mjs",
    "test:watch": "vitest",
    "pack:artifact": "yarn pack --filename agentdock.tgz",
    "prepack": "yarn build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentdock-ai/contracts": "^0.1.0",
    "@agentdock-ai/checkpoint": "^0.1.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "langchain": "^1.5.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@agentdock-ai/checkpoint-mongodb": "^0.1.0",
    "@agentdock-ai/checkpoint-postgres": "^0.1.0",
    "@agentdock-ai/checkpoint-redis": "^0.1.0",
    "@agentdock-ai/checkpoint-sqlite": "^0.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
