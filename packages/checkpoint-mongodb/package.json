{
  "name": "@agentdock-ai/checkpoint-mongodb",
  "version": "0.1.0",
  "description": "MongoDB checkpoint adapter for AgentDock",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentdock-ai/agentdock.git",
    "directory": "packages/checkpoint-mongodb"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
