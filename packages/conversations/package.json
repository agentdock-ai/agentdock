{
  "name": "@agentdock-ai/conversations",
  "version": "0.1.0",
  "description": "Durable LangGraph conversation records and Agentdock synchronization",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:packed": "node scripts/verify-packed-consumer.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@agentdock-ai/agentdock": "0.2.0",
    "@agentdock-ai/contracts": "0.2.0"
  },
  "peerDependencies": {
    "@langchain/langgraph-checkpoint": "^1.1.5"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
