{
  "name": "@agentdock/models",
  "version": "0.1.0",
  "description": "Optional LangChain model resolver for AgentDock",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-Zain01/agentdock.git",
    "directory": "packages/models"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
